[sub_resource type="GDScript" id="GDScript_0ebjn"]
resource_name = "BounceAroundLabel"
script/source = "@tool
extends Label

var time := 0.0

@export var angle_max := 15.0
@export var rect_max := Vector2(70.0,20.0)

@export var mult_scale := 1.2 :
	set(new) :
		mult_scale = new
		offset_transform_scale = Vector2.ONE * new

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	time += delta
	offset_transform_position = Vector2(
		sin(TAU*time * 0.82910) * rect_max.x,
		cos(TAU*time * 0.9287392873) * rect_max.y,
	)
	offset_transform_rotation = sin(TAU*time / 2.5784) * deg_to_rad(angle_max)
"

